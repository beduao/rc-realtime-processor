# Autostart do worker de reconhecimento no Raspberry Pi.
#
# NÃO edite __USER__/__DIR__ à mão: rode ./install_pi.sh, que substitui os
# placeholders pelo usuário e caminho reais e instala o serviço.
# (Manualmente: troque __USER__/__DIR__, copie para /etc/systemd/system/ e rode
#  `sudo systemctl daemon-reload && sudo systemctl enable --now facial-worker`.)
[Unit]
Description=Reconhecimento Facial - Worker
After=network-online.target time-sync.target
Wants=network-online.target
# Sem isto o systemd desiste após algumas falhas seguidas (ex.: câmera offline
# durante uma queda de energia) e o serviço fica morto até alguém intervir.
# (Precisa ficar em [Unit], não em [Service].)
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__DIR__/.venv/bin/python worker.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=facial-worker

[Install]
WantedBy=multi-user.target
